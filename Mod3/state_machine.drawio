                <mxCell id="state_setup" value="&lt;b&gt;Initialization &amp;amp; Setup&lt;/b&gt;&lt;br&gt;Configure GPIO 18 (OUT)&lt;br&gt;Open Serial /dev/ttyS0&lt;br&gt;Baud: 115200" style="rounded=1;whiteSpace=wrap;html=1;arcSize=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;align=center;verticalAlign=middle;fontColor=#000000;" parent="1" vertex="1">
